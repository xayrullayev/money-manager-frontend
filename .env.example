# API bazaviy manzili. Bakend-13 OpenAPI contractiga mos /api/v1 prefiksi bilan.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Standart mamlakat kodi (Design-AUTH-01: MVP uchun faqat +998)
VITE_DEFAULT_COUNTRY_CODE=+998

# SMS kod uzunligi va qayta yuborish intervali — backend contract tayyor bo'lguncha frontend default.
# Bakend tasdiqlagach shu qiymatlar contractdan runtime konfiguratsiya sifatida olinadi.
VITE_OTP_CODE_LENGTH=6
VITE_OTP_RESEND_SECONDS=60

# Mock API rejimi (Frontend-check-01). 1 bo'lsa real backend o'rniga brauzer ichidagi
# in-memory mock adapter ishlatiladi — real backendsiz UI/QA uchun.
# Mock rejimda OTP kod har doim: 111111. Demo telefon (onboarding tugagan): +998901234567.
VITE_API_MOCK=0
